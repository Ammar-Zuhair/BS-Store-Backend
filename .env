# ==========================================
# BS Store Platform - Environment Variables
# ==========================================

# ─── Database Configuration (PostgreSQL) ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=BS_Store
DB_USER=postgres
DB_PASSWORD=20501540

# ASP.NET Core Connection String override
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=BS_Store;Username=postgres;Password=20501540"

# ─── JWT Authentication ───
Jwt__Secret="BSStore_Dev_Super_Secret_Key_32_Characters_Minimum_Secure_2026!"
Jwt__Issuer="BSStore.API"
Jwt__Audience="BSStore.Apps"
Jwt__ExpiryMinutes="60"

# ─── Supabase / Object Storage ───
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_BUCKET="bs-store-uploads"

# ─── CORS Allowed Origins ───
CORS_ALLOWED_ORIGINS="http://localhost:8081,http://localhost:19006,exp://localhost:8081"
