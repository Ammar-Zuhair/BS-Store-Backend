# ==============================================================================
# BS Store Platform - Environment Variables Template
# ==============================================================================

# ─── 1. Database Configuration (Supabase / PostgreSQL) ───
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Full Connection String (Same for Render Web Service)
ConnectionStrings__DefaultConnection="postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ─── 2. JWT Authentication ───
Jwt__Secret="CHANGE_THIS_TO_AT_LEAST_32_CHAR_SECRET_KEY"
Jwt__Issuer="BSStore.API"
Jwt__Audience="BSStore.Apps"
Jwt__ExpiryMinutes="1440"

# ─── 3. Supabase Configuration ───
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_ANON_OR_SERVICE_KEY"
SUPABASE_BUCKET="Product Images"

# ─── 4. Server & Network ───
PORT=5295
ASPNETCORE_ENVIRONMENT=Production
CORS_ALLOWED_ORIGINS="http://localhost:8081,http://localhost:19006,exp://localhost:8081"

